# Anthropic API key for the optional Haiku 4.5 reminder analyzer.
#
# ⚠️ Client-side use is for local prototyping ONLY.
# `VITE_*` variables are inlined into the bundle at build time, so anyone
# with access to the deployed JS can read this key. For production:
#   1. Move the Anthropic call to a server (Vercel/Cloudflare/Express…).
#   2. Have the client POST { text, lang, personality } to /api/analyze.
#   3. Drop this var entirely.
#
# Without this key, the app falls back to local keyword parsing — still works,
# just less smart at follow-ups.
VITE_ANTHROPIC_API_KEY=sk-ant-...
